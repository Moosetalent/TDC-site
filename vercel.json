{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "next build",
  "outputDirectory": "out",
  "headers": [
    {
      "source": "/(opengraph-image|twitter-image)",
      "headers": [
        {
          "key": "Content-Type",
          "value": "image/png"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/manifesto",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/manifesto/",
      "destination": "/",
      "permanent": false
    }
  ]
}
